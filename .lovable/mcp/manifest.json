{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hpbillqujaculclavwkc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "unicost-ia-mcp",
      "version": "0.1.0",
      "title": "Unicost IA MCP"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Ver perfil",
        "description": "Retorna o perfil da usuária atualmente autenticada no Unicost IA (nome, e-mail, cidade, estado, profissão).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "calculate_fabric",
        "title": "Calcular metragem de tecido",
        "description": "Calcula a quantidade de tecido necessária para uma peça a partir das medidas corporais e recomenda tecidos ideais.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "peca": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Peça desejada, ex: 'vestido longo godê'."
            },
            "medidas": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Medidas corporais (busto, cintura, quadril, comprimento, etc)."
            },
            "tipoMedida": {
              "type": "string",
              "maxLength": 100,
              "description": "Tipo de medida, ex: 'adulto feminino'."
            }
          },
          "required": [
            "peca",
            "medidas"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "ask_sewing_assistant",
        "title": "Perguntar à assistente de costura",
        "description": "Faz uma pergunta livre à assistente de costura do Unicost IA (tecidos, modelagem, metragem, precificação, dicas).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "description": "Pergunta em português."
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
